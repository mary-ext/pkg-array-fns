{
	"lsp": {
		"deno": {
			"settings": {
				"deno": {
					"enable": true
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"language_servers": [
				"deno",
				"!typescript-language-server",
				"!vtsls",
				"!eslint"
			],
			"formatter": "language_server"
		},
		"TypeScript": {
			"language_servers": [
				"deno",
				"!typescript-language-server",
				"!vtsls",
				"!eslint"
			],
			"formatter": "language_server"
		},
		"TSX": {
			"language_servers": [
				"deno",
				"!typescript-language-server",
				"!vtsls",
				"!eslint"
			],
			"formatter": "language_server"
		},
		"JSON": {
			"formatter": {
				"external": {
					"command": "deno",
					"arguments": ["fmt", "--ext", "json", "-"]
				}
			}
		},
		"JSONC": {
			"formatter": {
				"external": {
					"command": "deno",
					"arguments": ["fmt", "--ext", "jsonc", "-"]
				}
			}
		},
		"Markdown": {
			"formatter": {
				"external": {
					"command": "deno",
					"arguments": ["fmt", "--ext", "md", "-"]
				}
			}
		}
	}
}
